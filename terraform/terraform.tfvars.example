# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored — never commit it (it can contain personal info).

# Run: curl -s https://checkip.amazonaws.com
# Then use the result as: "YOUR_IP/32"
my_ip = "REPLACE_WITH_YOUR_IP/32"

alert_email = "REPLACE_WITH_YOUR_EMAIL"

# Optional overrides (defaults shown):
# aws_region             = "ap-northeast-3"
# instance_type          = "t3.medium"
# billing_threshold_usd  = 25
